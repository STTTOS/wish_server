{
  "version": "1.0.0",
  "private": true,
  "description": "德州后台服务",
  "name": "@wishufree/texas-server",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --test -r ts-node/register \"src/**/*.test.ts\"",
    "dev": "npm run db:sync && nodemon  -w ./src --ext .ts --exec \"ts-node ./src/index.ts\"",
    "prettier": "prettier --write \"**/*.{js,ts,json,md}\"",
    "lint": "eslint --cache --ext .ts ./src",
    "lint:fix": "eslint --fix --cache --ext .ts ./src",
    "db:gui": "npx prisma studio",
    "db:migrate--dev": "npx prisma migrate dev --name modifiy",
    "db:migrate--prod": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate",
    "db:sync": "npm run db:migrate--dev && npm run db:generate",
    "db:watch": "nodemon -w prisma/schema.prisma --exec \"npm run db:sync\"",
    "copy-env": "cp ./.local.env .env",
    "backfill:match-settlement": "ts-node --transpile-only scripts/backfillMatchSettlementFromCore.ts",
    "publish": "npm run lint && npm run build && scp -r ./dist/* root@www.wishufree.com:/root/server/dist"
  },
  "author": "三分",
  "license": "ISC",
  "devDependencies": {
    "eslint-config-custom": "workspace:*",
    "prettier-config": "workspace:*",
    "tsconfig": "workspace:*"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,less,md,json}": [
      "pnpm run prettier"
    ],
    "**/*.{js,jsx,ts,tsx}": "pnpm run lint:fix"
  },
  "dependencies": {
    "@wishufree/texas-ws-contract": "workspace:*",
    "redis": "^5.11.0"
  }
}
