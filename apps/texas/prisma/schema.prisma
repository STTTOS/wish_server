datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/texas-client"
}

model User {
  id       Int     @id @default(autoincrement())
  balance  Float
  // 用户的头像
  avatar   String
  // 用户通过weChat注册的话会关联weChatId
  weChatId String?
  // 游戏昵称, 需要唯一, 设置为非必填, 在注册时给一个随机的名字, 降低注册门槛
  name     String  @unique
  // 新增用户名和密码字段
  username String  @unique
  // the password of the user should be hashed
  password String

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now())
  betRecords   BetRecord[]
  // matches    Match[]
  deletedAt    DateTime?
  matchRecords PlayerMatchRecord[]

  Room          Room[]
  roomMembers   RoomMember[]
  userRoomStats UserRoomStat[]
}

model MatchError {
  id Int @id @default(autoincrement())

  info      String   @db.LongText
  createdAt DateTime @default(now())

  matchId Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Room {
  id              Int            @id @default(autoincrement())
  // 房间代码
  code            String         @unique
  // 大盲注
  lowestBetAmount Int
  // 初始筹码
  initialChips    Int            @default(0)
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  thinkingTime    Int
  isPrivate       Boolean
  // 房主
  ownerId         Int
  owner           User           @relation(fields: [ownerId], references: [id])
  Match           Match[]
  members         RoomMember[]
  userRoomStats   UserRoomStat[]
}

// 房间成员（加入/退出）
model RoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

// 用户在房间内的对局统计
model UserRoomStat {
  id             Int      @id @default(autoincrement())
  userId         Int
  roomId         Int
  // 在房间内参与的对局次数
  matchCount     Int      @default(0)
  lastMatchAt    DateTime @default(now())
  // 胜负情况, 赢/输的筹码
  totalWager     Float    @default(0)
  // 总下注额
  totalBetAmount Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

enum Action {
  check
  fold
  bet
  raise
  allIn
  call
}

enum Stage {
  pre_flop
  flop
  turn
  river
}

enum PresentationType {
  //皇家同花顺
  z
  //同花顺
  y
  //四条
  x
  //葫芦
  w
  //同花
  v
  //顺子
  u
  //三条
  t
  //两对
  s
  //一对
  r
  //高牌
  q
}

// 记录玩家手牌
model PlayerMatchRecord {
  id             Int              @id @default(autoincrement())
  // 对应的对局 ID
  matchId        Int
  // 对应用户 ID
  userId         Int
  // Poke[]
  hand           Json
  // 记录用户角色
  role           String?
  // 输赢结果
  wager          Float            @default(0)
  presentation   PresentationType
  totalBetAmount Int              @default(0)
  isFold         Boolean          @default(false)
  isAllIn        Boolean          @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}

// 对局信息
model Match {
  id              Int               @id @default(autoincrement())
  // 对局开始的时间
  startedAt       DateTime          @default(now())
  // 对局结束的时间
  endedAt         DateTime?
  // 总的下注额度
  totalBetAmount  Float?
  // 记录游戏在哪个阶段结束的
  endStage        Stage?
  // 公共牌
  commonPokes     Json?
  // 存储计算后的最大牌力
  maxPresentation     PresentationType?
  // string[][] 记录这场对局结算时可以形成最大牌型的扑克牌
  maxPokes    Json?
  // 大盲注
  lowestBetAmount Int               @default(0)

  // 关联房间Id
  roomId               Int
  records              BetRecord[]
  playerMatchRecords   PlayerMatchRecord[]
  room                 Room                   @relation(fields: [roomId], references: [id])
  // 记录这场对局各个阶段开始, 结束的时间
  matchStageTimeRecord MatchStageTimeRecord[]

  MatchError MatchError[]
}

model MatchStageTimeRecord {
  id      Int       @id @default(autoincrement())
  stage   Stage
  startAt DateTime  @default(now())
  endAt   DateTime?

  matchId Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, stage])
}

// 用户的行为记录表
model BetRecord {
  id     Int    @id @default(autoincrement())
  // 用户的行为
  action Action
  // 下注金额, 过牌等行为默认为0
  amount Float  @default(0)
  // 记录用户在哪个阶段发生的行为
  stage  Stage

  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId Int?
}

