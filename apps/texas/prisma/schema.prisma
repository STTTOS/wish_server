datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/texas-client"
}

model User {
  id       Int     @id @default(autoincrement())
  balance  Float
  // 自定义头像 URL（上传等），可选
  avatarUrl String?
  // 客户端预设头像 key，如 cartoon/default
  avatarKey String  @default("cartoon/default")
  // 用户通过weChat注册的话会关联weChatId
  weChatId String?
  // 游戏昵称, 需要唯一, 设置为非必填, 在注册时给一个随机的名字, 降低注册门槛
  name     String  @unique
  // 新增用户名和密码字段
  username String  @unique
  // 是否管理员
  isAdmin  Boolean @default(false)
  // the password of the user should be hashed
  password String

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now())
  betRecords   BetRecord[]
  // matches    Match[]
  deletedAt    DateTime?
  matchRecords PlayerMatchRecord[]

  Room          Room[]
  roomMembers   RoomMember[]
  userRoomStats UserRoomStat[]
  settings      UserSettings?
  announcementReads AnnouncementRead[]
}

model UserSettings {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 是否展示历史战绩
  showHistoryRecords Boolean @default(true)
  // 是否展示战绩总览
  showRecordOverview Boolean @default(true)
  // 离线是否自动跟注
  autoCallOnOffline Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

enum AnnouncementType {
  activity
  update
  maintenance
}

enum AnnouncementStatus {
  published
  disabled
}

model Announcement {
  id Int @id @default(autoincrement())

  type AnnouncementType

  title String @db.VarChar(120)
  summary String @db.VarChar(300)
  content String @db.Text

  actionText String? @db.VarChar(40)
  actionUrl String? @db.VarChar(500)

  priority Int @default(0)

  status AnnouncementStatus
  publishAt DateTime
  expireAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  deletedAt DateTime?
  reads     AnnouncementRead[]

  @@index([status, priority, publishAt])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model MatchError {
  id Int @id @default(autoincrement())

  info      String   @db.LongText
  createdAt DateTime @default(now())

  matchId Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Room {
  id              Int            @id @default(autoincrement())
  // 房间代码
  code            String         @unique
  // 房间在业务侧的对局状态（用于“房主点击开始游戏”）
  gameStatus      RoomGameStatus @default(waiting)
  // 大盲注
  lowestBetAmount Int
  // 初始筹码
  initialChips    Int            @default(0)
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  thinkingTime    Int
  isPrivate       Boolean
  // 房主
  ownerId         Int
  // 仅未软删房间写入 ownerId；软删时置空。用于保证“一个用户最多一个有效房间”。
  activeOwnerId   Int?           @unique
  owner           User           @relation(fields: [ownerId], references: [id])
  Match           Match[]
  members         RoomMember[]
  userRoomStats   UserRoomStat[]
}

enum RoomGameStatus {
  waiting
  entering
  in_hand
  between_hands
}

// 房间成员（加入/退出）
model RoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

// 用户在房间内的对局统计
model UserRoomStat {
  id             Int      @id @default(autoincrement())
  userId         Int
  roomId         Int
  // 在房间内参与的对局次数
  matchCount     Int      @default(0)
  lastMatchAt    DateTime @default(now())
  // 胜负情况, 赢/输的筹码
  totalWager     Float    @default(0)
  // 总下注额
  totalBetAmount Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

enum ActionType {
  check
  fold
  bet
  raise
  allIn
  call
}

enum Stage {
  pre_flop
  flop
  turn
  river
}

// 座位角色（从庄家顺时针：庄家→小盲→大盲→枪口→…→关煞位），支持最多 10 人
enum Role {
  btn   // 庄家/按钮
  sb    // 小盲
  bb    // 大盲
  utg   // 枪口
  utg1  // 枪口+1
  utg2  // 枪口+2（10 人桌）
  mp    // 中位
  lj    // Lojack（10 人桌）
  hj    // 劫持位
  co    // 关煞位
}

enum RankCategory {
  //皇家同花顺
  z
  //同花顺
  y
  //四条
  x
  //葫芦
  w
  //同花
  v
  //顺子
  u
  //三条
  t
  //两对
  s
  //一对
  r
  //高牌
  q
}

// 记录玩家手牌
model PlayerMatchRecord {
  id             Int              @id @default(autoincrement())
  // 对应的对局 ID
  matchId        Int
  // 对应用户 ID
  userId         Int
  // [Poke, Poke]
  handPokes       Json
  // 该手牌中的座位角色（庄家/小盲/大盲等）
  role           Role?
  // 输赢结果
  wager          Float            @default(0)
  // 牌型
  rankCategory   RankCategory?
  // 牌型的唯一签名
  rankSignature  String?
  // 将牌型转化为大小存储, 方便数据库索引
  rankStrength Int @default(0)
  totalBetAmount Int              @default(0)
  isFold         Boolean          @default(false)
  isAllIn        Boolean          @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}

// 对局信息
model Match {
  id              Int               @id @default(autoincrement())
  // 对局开始的时间
  startedAt       DateTime          @default(now())
  // 对局结束的时间
  endedAt         DateTime?
  // 总的下注额度
  totalBetAmount  Float?
  // 记录游戏在哪个阶段结束的
  endStage        Stage?
  // 公共牌
  commonPokes     Json?
  // 存储计算后的最大牌力
  bestRankCategory     RankCategory?
  // string[][] 记录这场对局结算时可以形成最大牌型的扑克牌
  bestPokes    Json?
  // 大盲注
  lowestBetAmount Int               @default(0)

  // 关联房间Id
  roomId               Int
  records              BetRecord[]
  playerMatchRecords   PlayerMatchRecord[]
  room                 Room                   @relation(fields: [roomId], references: [id])
  // 记录这场对局各个阶段开始, 结束的时间
  matchStageTimeRecord MatchStageTimeRecord[]

  matchError MatchError[]
}

model MatchStageTimeRecord {
  id      Int       @id @default(autoincrement())
  stage   Stage
  startAt DateTime  @default(now())
  endAt   DateTime?

  matchId Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, stage])
}

// 用户的行为记录表
model BetRecord {
  id     Int    @id @default(autoincrement())
  // 用户的行为
  actionType ActionType
  // 下注金额, 过牌等行为默认为0
  amount Float  @default(0)
  // 记录用户在哪个阶段发生的行为
  stage  Stage

  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId Int?
}

