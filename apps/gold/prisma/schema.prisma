datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/gold-client"
}

/// 现货 tick（约 5s 一条）
model Tick {
  id              BigInt   @id @default(autoincrement())
  /// 采集时刻 epoch ms
  ts              BigInt   @unique
  usdOz           Float
  usdCny          Float?
  cnyG            Float?
  source          String   @db.VarChar(32)
  sourceUpdatedAt String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@index([ts])
}

/// 日线 OHLC（美元/盎司）；历史来自 currency-api，当日可由 tick 滚动更新
model DailyBar {
  date      String   @id @db.VarChar(10)
  ts        BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  /// 当日收盘 USD/CNY：tick 日=最后有效 Tick.usdCny；currency-api 日=同日 usd.cny 快照
  usdCnyClose Float?
  source    String   @db.VarChar(64)
  updatedAt DateTime @updatedAt

  @@index([ts])
}

/// 日终原料质量快照（每天一行；服务持续分析/迭代的体检）
model DailyQuality {
  /// 本地日历日 YYYY-MM-DD
  date              String   @id @db.VarChar(10)
  tickCount         Int
  /// 按全日 / POLL_INTERVAL 估算的期望条数（墙上时钟调度下与「每 interval 发起一轮」对齐）
  expectedTicks     Int
  coveragePct       Float
  gapCount          Int
  maxGapMs          Int
  firstTickAt       BigInt?
  lastTickAt        BigInt?
  dailyBarSource    String?  @db.VarChar(64)
  dailyBarFrozen    Boolean  @default(false)
  /// tick 日线收盘 − currency-api 单点（有则填）
  currencyCloseDiff Float?
  currencyCloseUsd  Float?
  tickCloseUsd      Float?
  note              String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// 金价服务登录用户（桌面/移动 App，非德州账号）
model GoldUser {
  id           BigInt            @id @default(autoincrement())
  username     String            @unique @db.VarChar(64)
  passwordHash String            @db.VarChar(255)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     GoldAuthSession[]
}

/// 每用户每平台仅一条会话（desktop / mobile 各一）
model GoldAuthSession {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  platform    String   @db.VarChar(16)
  deviceId    String   @db.VarChar(64)
  accessToken String   @unique @db.VarChar(128)
  expiresAt   BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        GoldUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  push        GoldPushRegistration?
  priceAlerts GoldPriceAlert[]

  @@unique([userId, platform])
  @@index([accessToken])
}

/// 移动端 Expo Push Token（绑会话；登出删会话即停推）
model GoldPushRegistration {
  id            BigInt            @id @default(autoincrement())
  sessionId     BigInt            @unique
  expoPushToken String            @db.VarChar(255)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  session       GoldAuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expoPushToken])
}

/// 服务端价位提醒（由 App 同步；美元或元/克）
model GoldPriceAlert {
  id              BigInt            @id @default(autoincrement())
  sessionId       BigInt
  clientAlertId   String            @db.VarChar(64)
  label           String            @db.VarChar(128)
  quoteUnit       String            @default("cnyG") @db.VarChar(8)
  targetCnyG      Float?
  targetUsdOz     Float?
  tolerancePct    Float             @default(0.2)
  enabled         Boolean           @default(true)
  removeAfterTrigger Boolean        @default(true)
  lastTriggeredAt BigInt?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  session         GoldAuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientAlertId])
  @@index([sessionId, enabled])
}

/// 采价失败 / skip 轻量日志（成功不写；短窗合并 count；约保留 7 天）
model PollLog {
  id        BigInt   @id @default(autoincrement())
  /// 首次出现 epoch ms
  ts        BigInt
  /// 最近一次 epoch ms
  lastTs    BigInt
  /// error | skip
  kind      String   @db.VarChar(16)
  message   String   @db.VarChar(512)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastTs])
  @@index([kind, lastTs])
}
