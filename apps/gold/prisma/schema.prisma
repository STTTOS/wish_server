datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/gold-client"
}

/// 现货 tick（约 5s 一条）
model Tick {
  id              BigInt   @id @default(autoincrement())
  /// 采集时刻 epoch ms
  ts              BigInt   @unique
  usdOz           Float
  usdCny          Float?
  cnyG            Float?
  source          String   @db.VarChar(32)
  sourceUpdatedAt String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@index([ts])
}

/// 日线 OHLC（美元/盎司）；历史来自 currency-api，当日可由 tick 滚动更新
model DailyBar {
  date      String   @id @db.VarChar(10)
  ts        BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  source    String   @db.VarChar(64)
  updatedAt DateTime @updatedAt

  @@index([ts])
}

/// 日终原料质量快照（每天一行；服务持续分析/迭代的体检）
model DailyQuality {
  /// 本地日历日 YYYY-MM-DD
  date              String   @id @db.VarChar(10)
  tickCount         Int
  /// 按全日 / POLL_INTERVAL 估算的期望条数
  expectedTicks     Int
  coveragePct       Float
  gapCount          Int
  maxGapMs          Int
  firstTickAt       BigInt?
  lastTickAt        BigInt?
  dailyBarSource    String?  @db.VarChar(64)
  dailyBarFrozen    Boolean  @default(false)
  /// tick 日线收盘 − currency-api 单点（有则填）
  currencyCloseDiff Float?
  currencyCloseUsd  Float?
  tickCloseUsd      Float?
  note              String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
