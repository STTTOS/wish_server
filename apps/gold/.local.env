# 数据连接 url（本地模板；真实连接请写到被 gitignore 的 .env）
DATABASE_URL=mysql://root:localtest00@localhost:3306/gold?schema=public

# 服务端口（默认 7504）
SERVER_PORT=7504

# 账号登录（推荐）：首次启动若不存在用户则创建种子账号（密码仅存哈希）
# GOLD_SEED_USERNAME=xuanJing
# GOLD_SEED_PASSWORD=          # 写在 .env，勿提交

# 可选遗留：静态 GOLD_API_TOKEN（运维脚本）；客户端已改用 /api/auth/login
GOLD_API_TOKEN=

# 采价间隔 ms（默认 5000）
POLL_INTERVAL_MS=5000

# 现货/汇率 HTTP 超时 ms（默认 = 间隔，且不会超过间隔）
# FETCH_TIMEOUT_MS=5000

# USD/CNY 重拉间隔 ms（默认 1800000 = 30 分钟）
# 级联：中国货币网即期（爬虫）→ currency-api
# FX_REFRESH_INTERVAL_MS=1800000

# 日线回看天数（默认 730 ≈ 两年）
DAILY_LOOKBACK_DAYS=730
