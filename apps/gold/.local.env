# 数据连接 url（本地模板；真实连接请写到被 gitignore 的 .env）
DATABASE_URL=mysql://root:localtest00@localhost:3306/gold?schema=public

# 服务端口（默认 7504）
SERVER_PORT=7504

# 可选：设置后 /api/*（除 /api/health）需带
# Authorization: Bearer <token> 或 X-Gold-Token: <token>
# 真实值写在 .env（gitignore），勿把密钥提交进仓库
GOLD_API_TOKEN=

# 采价间隔 ms（默认 5000）
POLL_INTERVAL_MS=5000

# 现货/汇率 HTTP 超时 ms（默认 = 间隔，且不会超过间隔）
# FETCH_TIMEOUT_MS=5000

# USD/CNY 重拉间隔 ms（默认 21600000 = 6 小时；Free 档约日更，无需 10 分钟狂拉）
# FX_REFRESH_INTERVAL_MS=21600000

# ExchangeRate-API Free/Pro KEY（优先于 open.er-api；真实值只写 .env，勿提交）
# https://www.exchangerate-api.com/
# 请求形如：https://v6.exchangerate-api.com/v6/<KEY>/latest/USD
# EXCHANGE_RATE_API_KEY=

# 日线回看天数（默认 730 ≈ 两年）
DAILY_LOOKBACK_DAYS=730
