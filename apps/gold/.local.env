# 数据连接 url（本地模板；真实连接请写到被 gitignore 的 .env）
DATABASE_URL=mysql://root:localtest00@localhost:3306/gold?schema=public

# 服务端口（默认 7504）
SERVER_PORT=7504

# 可选：设置后 /api/*（除 /api/health）需带
# Authorization: Bearer <token> 或 X-Gold-Token: <token>
# 真实值写在 .env（gitignore），勿把密钥提交进仓库
GOLD_API_TOKEN=

# 采价间隔 ms（默认 5000）
POLL_INTERVAL_MS=5000

# 日线回看天数（默认 730 ≈ 两年）
DAILY_LOOKBACK_DAYS=730
