# 数据连接 url（本地模板；真实连接请写到被 gitignore 的 .env）
DATABASE_URL=mysql://root:localtest00@localhost:3306/roadsign?schema=public

# 服务端口（默认 7505）
SERVER_PORT=7505

# 可选：设置后写操作 / 上传需带
# Authorization: Bearer <token> 或 X-Roadsign-Token: <token>
# 真实值写在 .env（gitignore），勿把密钥提交进仓库
# 生产务必填写；前端对应 VITE_ROADSIGN_API_TOKEN
ROADSIGN_API_TOKEN=

# 腾讯云 COS（与 blog / mart 共用）
COS_SECRET_ID=
COS_SECRET_KEY=
