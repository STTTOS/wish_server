# 数据连接 url（本地模板；真实连接请写到被 gitignore 的 .env）
DATABASE_URL=mysql://root:localtest00@localhost:3306/printer?schema=public

# token 加密秘钥
SECRET_KEY=

# 服务端口（可选，默认 7503）
SERVER_PORT=7503

# 腾讯云 COS（与 blog/mart 共用）
COS_SECRET_ID=
COS_SECRET_KEY=

# 定时清理：超过 N 天的 printing 对象（默认 3）
# PRINT_FILE_RETENTION_DAYS=3

# 微信小程序（方案一：wx.login → 上传凭证）。生产必填，未配置时拒绝公开上传。
# AppID 可在 project.config.json / 公众平台查看；Secret 仅放服务端。
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# 上传凭证有效期秒数（可选，默认 1800）
# UPLOAD_TOKEN_TTL_SECONDS=1800
