{
  "name": "@wishufree/cos-upload",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Tencent COS upload + image compress helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^2.13.4",
    "dayjs": "^1.11.11",
    "sharp": "^0.33.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8",
    "tsconfig": "workspace:*",
    "typescript": "^4.7.3"
  }
}
